      "rationale": {
        "opaque_actions": {
          "opaque_region_000": "Split fields/plugins/deferred executor/worker setup/model/weights/compile through reviewed existing methods. Mode branches remain in the entry; no original constructor is invoked twice.",
          "opaque_region_003": "KV block assignments stay inside kv_cache_allocate with the cache initialization RPC; publish kv_cache_config only afterwards.",
          "opaque_region_005": "The composite load_weights_and_trigger_compile joins/propagates weight errors internally. Non-overlap loading returns before compile. Keep weights and compilation readiness ahead of profiling/allocation/capture.",
          "opaque_region_007": "Split structured output, MM cache, scheduler and batch queue. Scheduler requires both cache configuration and structured output. Ready requires capture and runtime objects."
        },
        "aliases": "Mode/feature locals remain within entry/field construction; weight synchronization stays within its manager action; scheduler type is local; batch queue fields are written only by batch_queue; structured output is published before scheduler consumes it.",
        "gpu_lifetime": "CUDA-affecting worker RPCs share worker-0 affinity. Captures require KV allocation and finalized weights. Cache presence changes estimates, never bypasses validation.",
        "errors": "No fallback after action entry; wait for owned work and shut down executor on failure.",
        "scope": "Single-GPU EngineCore. Compiler and graph managers remain opaque composites. Existing deferred API boundaries were reused after review; this is not automated discovery of 25 novel boundaries."
      },
